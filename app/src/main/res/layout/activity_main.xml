<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- cabecalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_check"
                android:tint="@color/on_accent" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sg_700"
                    android:text="Smart Driver"
                    android:textColor="@color/text"
                    android:textSize="20sp" />
                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculadora de ofertas" />
            </LinearLayout>
            <TextView
                android:id="@+id/pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/green_bg"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="● Pronto"
                android:textColor="@color/green_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- leitura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="10dp"
                android:drawableTint="@color/muted"
                android:gravity="center_vertical"
                android:text="Lê a oferta na tela e mostra se compensa."
                android:textColor="@color/text2"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnMain"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Iniciar leitura" />
            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Você decide no Uber · nada é aceito sozinho · sem internet" />
        </LinearLayout>

        <!-- carro -->
        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seu carro" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/boxKmL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/kmL" android:text="Consumo" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                    <EditText android:id="@+id/kmL" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="11,5" android:importantForAutofill="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="km/L" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/boxFuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/fuel" android:text="Combustível" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginBottom="3dp" android:text="R$" android:textColor="@color/muted" android:textSize="13sp" />
                    <EditText android:id="@+id/fuel" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="6,19" android:importantForAutofill="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="/L" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- cidade -->
        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Onde você roda" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_pin" android:tint="@color/accent" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/city" android:text="Cidade" />
                <EditText
                    android:id="@+id/city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Maranguape"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:padding="0dp"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outras cidades liberadas" />
            <com.smartdriver.calc.FlowLayout
                android:id="@+id/cities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locais liberados fora das cidades" />
            <com.smartdriver.calc.FlowLayout
                android:id="@+id/places"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bairros da cidade (quando o Uber não mostra a cidade)" />
            <com.smartdriver.calc.FlowLayout
                android:id="@+id/hoods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- regras (editaveis) -->
        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Regras" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/minKm" android:text="Mínimo por km" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginBottom="3dp" android:text="R$" android:textColor="@color/muted" android:textSize="13sp" />
                    <EditText android:id="@+id/minKm" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="2,00" android:importantForAutofill="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="/km" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@id/minTrip" android:text="Mínimo por corrida" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginBottom="3dp" android:text="R$" android:textColor="@color/muted" android:textSize="13sp" />
                    <EditText android:id="@+id/minTrip" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="8,00" android:importantForAutofill="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Destino: só nas cidades e locais liberados acima. Deixe em branco para usar o padrão." />

        <Button
            android:id="@+id/btnManual"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:drawableTint="@color/text"
            android:text="Calcular manualmente" />

        <TextView
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Usa a captura de tela oficial do Android e lê o texto no próprio celular. Não usa API da Uber e não toca na tela. No Android 14+, ao autorizar, escolha “Tela inteira” ou o app Uber Driver." />
    </LinearLayout>
</ScrollView>
